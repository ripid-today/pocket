# --- Neon Postgres ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:pass@host/db?sslmode=require

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret
R2_BUCKET=pocket-books
# Public R2 endpoint (for SDK signing only; bucket stays private)
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# --- Gmail SMTP (OTP delivery) ---
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=16charapppassword

# --- Session ---
SESSION_SECRET=long-random-string-for-signing-cookies
APP_BASE_URL=https://pocket.ripid.vn
